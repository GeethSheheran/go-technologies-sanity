# Website and Studio share src/sanity/project.json. The legacy connection
# variables below do not override that public connection or attach a read token.
NEXT_PUBLIC_SANITY_PROJECT_ID=pk1w379x
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=
# Enable only after migration verification. Failure stops the build; no stale fallback.
SANITY_CONTENT_ENABLED=false
