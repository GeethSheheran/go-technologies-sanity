{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "nextjs",
      "installCommand": "npm ci",
      "buildCommand": "SANITY_CONTENT_ENABLED=true npm run build"
    },
    "studio": {
      "root": "studio",
      "framework": "sanity",
      "installCommand": "npm ci",
      "buildCommand": "npm run build:vercel",
      "devCommand": "npm run dev -- --port $PORT"
    }
  },
  "rewrites": [
    {
      "source": "/studio",
      "destination": { "service": "studio" }
    },
    {
      "source": "/studio/:path*",
      "destination": { "service": "studio" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "app" }
    }
  ]
}
