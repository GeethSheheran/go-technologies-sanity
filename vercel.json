{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "nextjs",
      "installCommand": "npm ci",
      "buildCommand": "npm run build"
    },
    "studio": {
      "root": "studio",
      "framework": "sanity",
      "installCommand": "npm ci",
      "buildCommand": "npm run build",
      "outputDirectory": "dist"
    }
  },
  "rewrites": [
    {
      "source": "/studio",
      "destination": { "service": "studio", "path": "/" }
    },
    {
      "source": "/studio/:path*",
      "destination": { "service": "studio", "path": "/:path*" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "app" }
    }
  ]
}
